{
  "format": "pxa-package-source-0.2",
  "id": "native-raster-demo",
  "version": "0.2.0",
  "release_sequence": 2,
  "name": "月岭天文台 · PXA 3D 压测",
  "description": "蓝调雪峰上的铜制浑天仪、月石星盘和镂空廊道，按照固定环绕、穿行和俯视镜头进行原生像素光栅压测",
  "min_sdk": [2, 1],
  "build": {
    "system": "cmake",
    "linear_memory": {"maximum_bytes": 524288, "pinned": false}
  },
  "components": [{
    "id": "main",
    "kind": "ui",
    "cmake_target": "pxa_main",
    "services": ["clock", "game-render", "log", "window"],
    "wasi": {"version": "preview1", "libc": "wasi-libc", "features": ["monotonic-clock", "wall-clock"]}
  }]
}
