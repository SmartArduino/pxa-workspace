{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-display-composition",
  "version": "1.0.0",
  "name": "LCD Composition Benchmark",
  "description": "Guest-mapped RGB565 frame example",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "clock",
        "surface",
        "window",
        "log"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "release_sequence": 1
}
