# Input section ordinals are checked against this BALANCED archive's hash.
# Cold CAVLC paths and unused deblock/packing code stay accessible in flash.
[mapping:pxa_gamekit_stream_asm]
archive: libesp_openh264.a
entries:
    cabac_decoder (noflash)
    cabac_pie (noflash)
    mc_pie (noflash)

