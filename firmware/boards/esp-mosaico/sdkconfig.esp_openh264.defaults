# Keep frequently used decoder code in instruction RAM. The matching
# archive's unused paths are covered by the S31 streaming linker fragment.
# CONFIG_ESP_OPENH264_PROFILE_MINIMAL is not set
CONFIG_ESP_OPENH264_PROFILE_BALANCED=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The S31 packing instructions run on core 1. The decoder front end
# remains on core 0 while its native worker reconstructs on core 1.
CONFIG_PXA_RUNTIME_TASK_AFFINITY=1
# Leave the 16 MiB PSRAM available for the decoded pictures and runtime heaps.
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
# Keep HTTPS media refills working while the decoder and display own DMA memory.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# Receive aggregated Wi-Fi bursts while keeping simultaneous audio/video
# TCP sessions small enough for the panel's DMA heap.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
# The decoder allocates its picture buffers outside the resource allocator.
CONFIG_PXA_RESOURCE_PSRAM_HEADROOM_BYTES=524288
CONFIG_PXA_MOSAICO_LCD_COMPACT_UI=y
