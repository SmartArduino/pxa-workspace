CONFIG_IDF_TARGET_ESP32S31=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Native USB CDC has no hardware RTS/DTR auto-download wiring. Enter ROM
# download mode with BOOT before flashing, and keep that USB session intact.
CONFIG_ESPTOOLPY_BEFORE_NORESET=y
# The bundled esptool v5.4 S31 stub is verified over external UART. Override
# IDF bring-up's ROM-only default to enable compressed, buffered writes.
# CONFIG_ESPTOOLPY_NO_STUB is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/esp-mosaico/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_250M=y
# WAMR relocates AOT text into the PSRAM heap at runtime. On ESP32-S31 the
# preconfigured PMP layout locks that heap RW, which faults on AOT execution.
# CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION is not set
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=262144

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000

CONFIG_LITTLEFS_PAGE_SIZE=512
CONFIG_LITTLEFS_OBJ_NAME_LEN=192
CONFIG_LITTLEFS_READ_SIZE=256
CONFIG_LITTLEFS_WRITE_SIZE=256
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=4096

CONFIG_LV_OS_FREERTOS=y
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_DRAW_THREAD_STACK_SIZE=32768
CONFIG_LV_DRAW_THREAD_PRIO=4
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=24
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_INDEV_DEF_GESTURE_ROTATION_THRESHOLD=150
CONFIG_LV_CACHE_DEF_SIZE=4194304
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=32
# Keep LVGL's small UI primitives on the two software draw workers.  The PPA
# renderer performs synchronous cache maintenance for every operation on the
# PSRAM framebuffer, which is slower for the settings list's many small fills.
# CONFIG_LV_USE_PPA is not set
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_FREETYPE_USE_LVGL_PORT=n
CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT=2048
# CONFIG_LV_USE_LODEPNG is not set
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=2

CONFIG_PXA_ENABLED=y
CONFIG_PXA_TRUST_BUNDLED_DEVELOPMENT_KEY=y
CONFIG_PXA_STORAGE_PARTITION_LABEL="pxa_data"
CONFIG_PXA_MOUNT_POINT="/pxa"
CONFIG_PXA_STORAGE_FORMAT_IF_MOUNT_FAILED=y
CONFIG_PXA_BUILTIN_PACKAGE_ROOT="system/pxa/factory"
CONFIG_PXA_STATE_ROOT="pxa-state"
CONFIG_PXA_WASI_LIBC=y
CONFIG_PXA_GUEST_STACK_SIZE=16384
CONFIG_PXA_HOST_MANAGED_HEAP_SIZE=16384
CONFIG_PXA_RUNTIME_TASK_STACK_SIZE=12288
CONFIG_PXA_RUNTIME_TASK_PRIORITY=3
CONFIG_PXA_RUNTIME_TASK_AFFINITY=1
CONFIG_PXA_CALL_TIMEOUT_MS=3000
CONFIG_PXA_PARALLEL_RASTER=y
CONFIG_PXA_RASTER_WORKER_AFFINITY=0
CONFIG_PXA_RASTER_WORKER_PRIORITY=4
CONFIG_PXA_RASTER_WORKER_STACK_SIZE=4096

CONFIG_WAMR_ENABLE_AOT=y
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_ENABLE_LIB_PTHREAD=y
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=y
CONFIG_WAMR_ENABLE_LIBC_WASI=y
CONFIG_WAMR_ENABLE_REF_TYPES=y
CONFIG_WAMR_ENABLE_SHARED_MEMORY=y
CONFIG_WAMR_LINEAR_MEMORY_IN_PSRAM=y
CONFIG_WAMR_AOT_CODE_IN_PSRAM=y

CONFIG_PXSYS_REFERENCE_UI=y
CONFIG_PXSYS_REFERENCE_UI_STATUS_BAR=y
CONFIG_PXSYS_REFERENCE_UI_WIFI=y
CONFIG_PXSYS_REFERENCE_UI_BATTERY_PERCENT=n
CONFIG_PXSYS_REFERENCE_UI_NAVIGATION_BAR=y
CONFIG_PXSYS_REFERENCE_UI_NAVIGATION_GESTURES=y
CONFIG_PXSYS_REFERENCE_UI_GESTURE_HANDLE=y
CONFIG_PXSYS_REFERENCE_UI_LAUNCHER_COLUMNS=3
CONFIG_PXSYS_REFERENCE_UI_LAUNCHER_ROWS=2
CONFIG_PXSYS_REFERENCE_UI_NOTIFICATION_SHADE=y
CONFIG_PXSYS_REFERENCE_UI_WALLPAPER=n
CONFIG_PXSYS_REFERENCE_UI_ANIMATIONS=y

CONFIG_PXADB_ENABLED=y
CONFIG_PXADB_AUTOSTART=y
CONFIG_PXADB_TRANSPORT_USB_CDC=y
CONFIG_PXADB_TEST_CONTROL=y

CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512

CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=1
# Match Watcher pools to reserve SRAM for SPI DMA, audio and PXADB.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=32
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM_PREFER=y
# CONFIG_LITTLEFS_MALLOC_STRATEGY_DEFAULT is not set


# Prepared 16-bit game effects share the bounded PSRAM resource cache.
CONFIG_PXA_ASSET_EXTERNAL_BYTES=1572864
# Continue servicing audio DMA during flash/NVS writes with cache disabled.
CONFIG_I2S_ISR_IRAM_SAFE=y
