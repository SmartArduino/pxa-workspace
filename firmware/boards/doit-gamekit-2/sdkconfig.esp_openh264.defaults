# Keep PSRAM available for decoded pictures and offload TLS payload decryption.
# CONFIG_ESP_OPENH264_PROFILE_MINIMAL is not set
CONFIG_ESP_OPENH264_PROFILE_BALANCED=y
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
CONFIG_MBEDTLS_HARDWARE_AES=y
# TLS handshakes share the board with Wi-Fi, audio and LCD DMA.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Save instruction RAM for the decoder and keep Wi-Fi payload buffers in PSRAM where supported.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# The vendor's reference pictures are allocated outside the PXA quota.
CONFIG_PXA_RESOURCE_PSRAM_HEADROOM_BYTES=1048576
# Keep several high-latency DASH bursts in flight alongside the audio stream.
CONFIG_LWIP_TCP_WND_DEFAULT=34560
CONFIG_LWIP_TCP_RECVMBOX_SIZE=26
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Receive aggregated video bursts without exhausting the static RX descriptors.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# Media downloads need fewer transmit buffers than receive buffers.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
# The panel uses a normal queued DMA interrupt.
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
