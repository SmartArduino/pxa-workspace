CONFIG_IDF_TARGET_ESP32S3=y
# SenseCAP Watcher: ESP32-S3-WROOM-1 with 32 MB flash and 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/sensecap-watcher/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# The QSPI LCD bounces color chunks through internal DMA memory, and the WiFi
# driver needs internal buffers; keep a large internal reserve available.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=262144
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
# The Watcher exposes UART0 on the debug connector, matching the factory
# firmware. USB-Serial-JTAG stays available as a secondary console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Long littlefs/FreeType flash operations run with the cache disabled.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=10000
# Keep the Wi-Fi static RX pool small enough for the internal RAM budget.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
# The Wi-Fi event handlers run on the default event loop task; 2304 bytes is
# too small and its overflow corrupts the loop mutex.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=n
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n

CONFIG_LITTLEFS_PAGE_SIZE=512
CONFIG_LITTLEFS_OBJ_NAME_LEN=96
CONFIG_LITTLEFS_READ_SIZE=256
CONFIG_LITTLEFS_WRITE_SIZE=256
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_CACHE_SIZE=4096
CONFIG_LITTLEFS_BLOCK_CYCLES=256
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM_PREFER=y

CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# Refreshes are invalidation-driven with direct-mode rendering; a 16 ms period
# keeps drags and animations smooth without forcing full-screen redraws.
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_DRAW_THREAD_STACK_SIZE=32768
# Multi-touch: the SPD2010 reports up to five points and the LVGL port feeds
# two of them to the pinch/rotate/two-finger-swipe recognizers.
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_FREETYPE_USE_LVGL_PORT=n
CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT=2048
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_LODEPNG=y

# The board owns I2C0 with the new i2c_master driver, so the ES8311 control
# interface must use the IDF 5.3+ bus handle instead of the legacy driver.
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CODEC_ES8311_SUPPORT=y

CONFIG_PXA_ENABLED=y
CONFIG_PXA_TRUST_BUNDLED_DEVELOPMENT_KEY=y
CONFIG_PXA_STORAGE_PARTITION_LABEL="pxa_data"
CONFIG_PXA_MOUNT_POINT="/pxa"
CONFIG_PXA_STORAGE_FORMAT_IF_MOUNT_FAILED=y
CONFIG_PXA_BUILTIN_PACKAGE_ROOT="system/pxa/factory"
CONFIG_PXA_STATE_ROOT="pxa-state"
CONFIG_PXA_WASI_LIBC=y
CONFIG_PXA_GUEST_STACK_SIZE=16384
CONFIG_PXA_HOST_MANAGED_HEAP_SIZE=16384
CONFIG_PXA_RUNTIME_TASK_STACK_SIZE=12288
CONFIG_PXA_RUNTIME_TASK_PRIORITY=3
CONFIG_PXA_RUNTIME_TASK_AFFINITY=0
CONFIG_PXA_CALL_TIMEOUT_MS=3000
CONFIG_PXA_PRIVATE_FS_QUOTA_BYTES=65536
CONFIG_PXA_PRIVATE_FS_MAX_OPEN_HANDLES=8

CONFIG_WAMR_ENABLE_AOT=y
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_ENABLE_LIB_PTHREAD=y
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=y
CONFIG_WAMR_ENABLE_LIBC_WASI=y
CONFIG_WAMR_ENABLE_REF_TYPES=y
CONFIG_WAMR_ENABLE_SHARED_MEMORY=y
CONFIG_WAMR_LINEAR_MEMORY_IN_PSRAM=y
CONFIG_WAMR_AOT_CODE_IN_PSRAM=y

CONFIG_PXSYS_REFERENCE_UI=y
CONFIG_PXSYS_REFERENCE_UI_STATUS_BAR=y
CONFIG_PXSYS_REFERENCE_UI_WIFI=y
CONFIG_PXSYS_REFERENCE_UI_CELLULAR=n
CONFIG_PXSYS_REFERENCE_UI_BATTERY_PERCENT=y
CONFIG_PXSYS_REFERENCE_UI_NAVIGATION_BAR=y
CONFIG_PXSYS_REFERENCE_UI_NAVIGATION_GESTURES=y
CONFIG_PXSYS_REFERENCE_UI_GESTURE_HANDLE=y
CONFIG_PXSYS_REFERENCE_UI_LAUNCHER_COLUMNS=2
CONFIG_PXSYS_REFERENCE_UI_LAUNCHER_ROWS=2
CONFIG_PXSYS_REFERENCE_UI_NOTIFICATION_SHADE=y
CONFIG_PXSYS_REFERENCE_UI_WALLPAPER=n
CONFIG_PXSYS_REFERENCE_UI_ANIMATIONS=y
CONFIG_PXSYS_REFERENCE_UI_TASK_SWITCHER_CARDS=y
CONFIG_PXSYS_REFERENCE_UI_TASK_PREVIEW_COUNT=3

CONFIG_PXADB_ENABLED=y
CONFIG_PXADB_AUTOSTART=y
CONFIG_PXADB_TEST_CONTROL=y
# The Watcher's native USB port is not always wired; tunnel PXADB over UART0,
# which is also the console. The host client skips non-PXADB log lines.
# UART0 runs at 460800 for both the console and PXADB; monitor at the same
# rate (the ROM banner stays at 115200).
CONFIG_PXADB_TRANSPORT_UART=y
CONFIG_PXADB_UART_PORT=0
CONFIG_PXADB_UART_BAUD=460800
CONFIG_ESP_CONSOLE_UART_BAUDRATE=460800
