{
  "format": "pxa-package-source-0.1",
  "min_sdk": [2, 1], "target_sdk": [2, 1], "compile_sdk": [2, 1],
  "id": "pxa-rot-surface", "version": "1.0.0",
  "name": "Static rotation regression",
  "description": "Exactly one direct Surface redraw after a half-turn",
  "build": {"system": "cmake", "source_dir": ".",
            "linear_memory": {"maximum_bytes": 2097152, "pinned": true}},
  "components": [{"id": "main", "kind": "ui",
    "services": ["clock", "surface", "window", "log"],
    "cmake_target": "pxa_main",
    "wasi": {"version": "preview1", "libc": "wasi-libc",
             "features": ["monotonic-clock", "wall-clock"]}}]
}
