ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends python3-dev python3-pip python3-setuptools python3-wheel libpipewire-0.3-dev libspa-0.2-dev && rm -rf /var/lib/apt/lists/*
COPY sdl2.tar.gz curl.tar.gz /tmp/
RUN mkdir -p /native/src && tar -xzf /tmp/sdl2.tar.gz -C /native/src && tar -xzf /tmp/curl.tar.gz -C /native/src
RUN cmake -S /native/src/curl -B /native/curl-build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/native -DBUILD_SHARED_LIBS=ON -DBUILD_CURL_EXE=OFF -DBUILD_TESTING=OFF -DCURL_USE_OPENSSL=ON -DCURL_USE_LIBPSL=OFF -DUSE_LIBIDN2=OFF -DCURL_USE_LIBSSH=OFF -DCURL_USE_LIBSSH2=OFF -DCURL_USE_GSSAPI=OFF -DCURL_DISABLE_LDAP=ON -DCURL_DISABLE_LDAPS=ON -DCURL_DISABLE_DICT=ON -DCURL_DISABLE_FILE=ON -DCURL_DISABLE_FTP=ON -DCURL_DISABLE_GOPHER=ON -DCURL_DISABLE_IMAP=ON -DCURL_DISABLE_MQTT=ON -DCURL_DISABLE_POP3=ON -DCURL_DISABLE_RTSP=ON -DCURL_DISABLE_SMB=ON -DCURL_DISABLE_SMTP=ON -DCURL_DISABLE_TELNET=ON -DCURL_DISABLE_TFTP=ON && cmake --build /native/curl-build --parallel 3 && cmake --install /native/curl-build
RUN cmake -S /native/src/sdl2 -B /native/sdl-build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/native -DSDL_SHARED=ON -DSDL_STATIC=OFF -DSDL_TEST=OFF -DSDL_ALSA=OFF -DSDL_PULSEAUDIO=OFF -DSDL_PIPEWIRE=ON -DSDL_PIPEWIRE_SHARED=OFF -DSDL_JACK=OFF -DSDL_SNDIO=OFF -DSDL_LIBSAMPLERATE=OFF -DSDL_DBUS=OFF -DSDL_IBUS=OFF -DSDL_FCITX=OFF -DSDL_LIBUDEV=OFF -DSDL_HIDAPI_LIBUSB=OFF -DSDL_KMSDRM=OFF -DSDL_WAYLAND_LIBDECOR=OFF -DSDL_WAYLAND_LIBDECOR_SHARED=OFF && cmake --build /native/sdl-build --parallel 3 && cmake --install /native/sdl-build
RUN python3 -m pip download --no-binary=:all: --no-deps --no-build-isolation Pillow==10.2.0 -d /native/src && echo 'e87f0b2c78157e12d7686b27d63c070fd65d994e8ddae6f328e0dcf4a0cd007e  /native/src/pillow-10.2.0.tar.gz' | sha256sum -c - && tar -xzf /native/src/pillow-10.2.0.tar.gz -C /native/src && cd /native/src/pillow-10.2.0 && CC=clang CXX=clang++ python3 setup.py build_ext --disable-raqm --disable-tiff --disable-imagequant --disable-platform-guessing && CC=clang CXX=clang++ python3 setup.py build && rm -rf /usr/lib/python3/dist-packages/PIL && cp -R build/lib.*/PIL /usr/lib/python3/dist-packages/PIL
# These optional CPython bindings are not used by PXA tools and link copyleft libraries.
RUN rm -f /usr/lib/python3.12/lib-dynload/_gdbm*.so /usr/lib/python3.12/lib-dynload/_dbm*.so /usr/lib/python3.12/lib-dynload/readline*.so /usr/lib/python3.12/lib-dynload/_tkinter*.so /usr/lib/python3.12/lib-dynload/_crypt*.so /usr/lib/python3.12/lib-dynload/nis*.so
ENV LD_LIBRARY_PATH=/native/lib:/native/lib64 PKG_CONFIG_PATH=/native/lib/pkgconfig:/native/lib64/pkgconfig

RUN apt-get update && apt-get install -y --no-install-recommends pigz && rm -rf /var/lib/apt/lists/*
