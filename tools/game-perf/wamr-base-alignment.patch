diff --git a/core/iwasm/compilation/aot_llvm.c b/core/iwasm/compilation/aot_llvm.c
index 8eaa9d8..8474997 100644
--- a/core/iwasm/compilation/aot_llvm.c
+++ b/core/iwasm/compilation/aot_llvm.c
@@ -1352,6 +1352,8 @@ create_memory_info(const AOTCompContext *comp_ctx, AOTFuncContext *func_ctx,
             aot_set_last_error("llvm build load failed");
             return false;
         }
+        aot_set_memory_base_alignment(func_ctx->mem_info[0].mem_base_addr,
+                                      comp_ctx->module);
         if (!(func_ctx->mem_info[0].mem_cur_page_count_addr =
                   LLVMBuildLoad2(comp_ctx->builder, I32_TYPE,
                                  func_ctx->mem_info[0].mem_cur_page_count_addr,
@@ -1376,6 +1378,8 @@ create_memory_info(const AOTCompContext *comp_ctx, AOTFuncContext *func_ctx,
             aot_set_last_error("llvm build load failed");
             return false;
         }
+        aot_set_memory_base_alignment(func_ctx->mem_info[0].mem_base_addr,
+                                      comp_ctx->module);
     }
 #endif
 
@@ -4267,3 +4271,18 @@ aot_set_cond_br_weights(AOTCompContext *comp_ctx, LLVMValueRef cond_br,
 
     return true;
 }
+
+/* The constant-offset memory path already relies on this runtime invariant.
+ * Describe the loaded base pointer, not the alignment of arbitrary Wasm
+ * accesses. LLVM can then prove alignment after local SSA/loop optimization;
+ * unknown offsets and every bounds/overflow check retain their semantics. */
+void
+aot_set_memory_base_alignment(LLVMValueRef pointer, LLVMModuleRef module)
+{
+    LLVMContextRef context = LLVMGetModuleContext(module);
+    LLVMMetadataRef value = LLVMValueAsMetadata(
+        LLVMConstInt(LLVMInt64TypeInContext(context), 8, false));
+    LLVMMetadataRef node = LLVMMDNodeInContext2(context, &value, 1);
+    LLVMSetMetadata(pointer, LLVMGetMDKindIDInContext(context, "align", 5),
+                    LLVMMetadataAsValue(context, node));
+}
