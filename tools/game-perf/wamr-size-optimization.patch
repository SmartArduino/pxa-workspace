+    if (comp_ctx->opt_level >= 4) {
+        const Triple targetTriple(
+            reinterpret_cast<Module *>(module)->getTargetTriple());
+        for (Function &F : *reinterpret_cast<Module *>(module)) {
+            if (!F.isDeclaration()) {
+                // AOT stack accounting has no entries for outlined helpers.
+                F.addFnAttr("nooutline");
+                F.addFnAttr(Attribute::OptimizeForSize);
+                // RV32 minsize emits wide-shift libcalls which the current
+                // runtime does not export. Retain inline shifts and the Oz
+                // IR pipeline without requiring a new Host symbol ABI.
+                if (comp_ctx->opt_level == 5
+                    && targetTriple.getArch() != Triple::riscv32)
+                    F.addFnAttr(Attribute::MinSize);
