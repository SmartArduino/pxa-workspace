+     * existing reload path. */
+    bool fixed_local_memory = module->import_memory_count == 0
+        && module->memory_count == 1 && module->memories[0].flags == 1
+        && module->memories[0].init_page_count > 0
+        && module->memories[0].init_page_count == module->memories[0].max_page_count;
     bool mem_space_unchanged =
         (!func->has_op_memory_grow && !func->has_op_func_call)
-        || (!module->possible_memory_grow);
+        || (!module->possible_memory_grow) || fixed_local_memory;
 #if WASM_ENABLE_SHARED_MEMORY != 0
     bool is_shared_memory;
 #endif
