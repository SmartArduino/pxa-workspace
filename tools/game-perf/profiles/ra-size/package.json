{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-red-alert",
  "version": "0.1.4",
  "name": "Red Alert",
  "description": "Private source-size comparison; unchanged units, caches, renderer and current PXA audio settings",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 10027008,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "surface",
        "audio",
        "clock",
        "permission",
        "window",
        "log",
        "ui",
        {
          "name": "fs",
          "min_version": [
            0,
            3
          ],
          "features": [
            "app-media-root",
            "read-at",
            "scoped-roots"
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            0
          ]
        }
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      },
      "artifact": "aot"
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "release_sequence": 200,
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  }
}
