{
  "format": "pxa-package-source-0.1",
  "min_sdk": [2, 1],
  "target_sdk": [2, 1],
  "compile_sdk": [2, 1],
  "id": "pxa-main-loop-probe",
  "version": "0.1.0",
  "release_sequence": 1,
  "name": "Main loop probe",
  "description": "Device validation of native event waits, input, lifecycle and terminal cancellation.",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {"maximum_bytes": 262144, "pinned": true}
  },
  "components": [{
    "id": "main", "kind": "ui", "execution_model": "main-loop",
    "cmake_target": "pxa_main", "services": ["ui", "window", "log"],
    "wasi": {"version": "preview1", "libc": "wasi-libc", "features": ["monotonic-clock", "wall-clock"]}
  }],
  "permissions": []
}
