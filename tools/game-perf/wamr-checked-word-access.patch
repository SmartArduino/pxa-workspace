+/* Experiment: retain the bytewise fallback, but use one native word operation
+ * when a dynamic pointer is aligned. Run after IR optimization so merging the
+ * two loads cannot erase the checked fast path. Existing bounds checks have
+ * already executed before this access, including at the end of memory. */
+static void addCheckedWordAccesses(Module &M)
+{
+    auto Arch = Triple(M.getTargetTriple()).getArch();
+    if (Arch != Triple::riscv32 && Arch != Triple::x86_64)
+        return;
+    SmallVector<Instruction *, 256> work;
+    for (Function &F : M)
+        for (BasicBlock &BB : F)
+            for (Instruction &I : BB) {
+                if (auto *L = dyn_cast<LoadInst>(&I)) {
+                    if (!L->isAtomic() && !L->isVolatile()
+                        && L->getType()->isIntegerTy(32) && L->getAlign() < Align(4))
+                        work.push_back(L);
+                } else if (auto *S = dyn_cast<StoreInst>(&I)) {
+                    if (!S->isAtomic() && !S->isVolatile()
+                        && S->getValueOperand()->getType()->isIntegerTy(32)
+                        && S->getAlign() < Align(4))
+                        work.push_back(S);
+                }
+            }
+    for (Instruction *I : work) {
+        auto *L = dyn_cast<LoadInst>(I);
+        auto *S = dyn_cast<StoreInst>(I);
+        Value *P = L ? L->getPointerOperand() : S->getPointerOperand();
+        BasicBlock *Head = I->getParent();
+        Function *F = Head->getParent();
+        BasicBlock *Join = Head->splitBasicBlock(I->getIterator(), "word.join");
+        Head->getTerminator()->eraseFromParent();
+        BasicBlock *Fast = BasicBlock::Create(M.getContext(), "word.aligned", F, Join);
+        BasicBlock *Slow = BasicBlock::Create(M.getContext(), "word.unaligned", F, Join);
+        IRBuilder<> B(Head);
+        Value *Address = B.CreatePtrToInt(P, B.getInt32Ty());
+        B.CreateCondBr(B.CreateICmpEQ(B.CreateAnd(Address, B.getInt32(3)), B.getInt32(0)), Fast, Slow);
+        B.SetInsertPoint(Fast);
+        LoadInst *Loaded = nullptr;
+        if (L) Loaded = B.CreateAlignedLoad(L->getType(), P, Align(4));
+        else B.CreateAlignedStore(S->getValueOperand(), P, Align(4));
+        B.CreateBr(Join);
+        I->removeFromParent();
+        I->insertInto(Slow, Slow->end());
+        B.SetInsertPoint(Slow);
+        B.CreateBr(Join);
+        if (L) {
+            PHINode *Phi = PHINode::Create(L->getType(), 2, "word.result", &Join->front());
+            L->replaceAllUsesWith(Phi);
+            Phi->addIncoming(Loaded, Fast);
+            Phi->addIncoming(L, Slow);
+        }
+    }
+}
