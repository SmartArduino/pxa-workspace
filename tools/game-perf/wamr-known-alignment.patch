diff --git a/core/iwasm/compilation/aot_llvm_extra.cpp b/core/iwasm/compilation/aot_llvm_extra.cpp
index 3a3dc29..1f6c0b7 100644
--- a/core/iwasm/compilation/aot_llvm_extra.cpp
+++ b/core/iwasm/compilation/aot_llvm_extra.cpp
@@ -55,6 +55,8 @@
 #include <llvm/Transforms/Scalar/GVN.h>
 #include <llvm/Passes/PassBuilder.h>
 #include <llvm/Analysis/TargetLibraryInfo.h>
+#include <llvm/Analysis/ValueTracking.h>
+#include <llvm/Support/KnownBits.h>
 #if LLVM_VERSION_MAJOR >= 12
 #include <llvm/Analysis/AliasAnalysis.h>
 #endif
@@ -438,3 +440,16 @@ aot_compress_aot_func_names(AOTCompContext *comp_ctx, uint32 *p_size)
     *p_size = compressed_str_len;
     return compressed_str;
 }
+
+extern "C" unsigned int
+aot_known_memory_alignment(LLVMValueRef offset, LLVMModuleRef module)
+{
+    Value *value = unwrap(offset);
+    if (!value->getType()->isIntegerTy())
+        return 1;
+    KnownBits bits = computeKnownBits(value, unwrap(module)->getDataLayout());
+    unsigned int zero_bits = bits.countMinTrailingZeros();
+    // The existing constant-address path already assumes an 8-byte-aligned
+    // linear-memory base. Keep that bound and every overflow/bounds check.
+    return 1U << (zero_bits > 3 ? 3 : zero_bits);
+}
