diff --git a/core/iwasm/compilation/aot_llvm.h b/core/iwasm/compilation/aot_llvm.h
index 5bd75a3..42583ab 100644
--- a/core/iwasm/compilation/aot_llvm.h
+++ b/core/iwasm/compilation/aot_llvm.h
@@ -53,6 +53,9 @@
 extern "C" {
 #endif
 
+/* Infer only guaranteed low address bits; never trust Wasm alignment hints. */
+unsigned int aot_known_memory_alignment(LLVMValueRef offset, LLVMModuleRef module);
+
 #if LLVM_VERSION_MAJOR < 14
 #define LLVMBuildLoad2(builder, type, value, name) \
