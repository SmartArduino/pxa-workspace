# Include before ESP-IDF project.cmake; call configure after it, before project().
get_filename_component(PXA_HOST_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED PXA_HOST_SDK_LOCK)
    set(PXA_HOST_SDK_LOCK "${CMAKE_SOURCE_DIR}/pxa-host-sdk.lock.json")
endif()
if(NOT EXISTS "${PXA_HOST_SDK_LOCK}")
    message(FATAL_ERROR "A product-owned pxa-host-sdk.lock.json is required")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${PXA_HOST_SDK_LOCK}" "${PXA_HOST_SDK_ROOT}/host-sdk.json")
file(READ "${PXA_HOST_SDK_LOCK}" pxa_sdk_lock)
string(JSON pxa_sdk_manifest_hash GET "${pxa_sdk_lock}" manifest_sha256)
file(SHA256 "${PXA_HOST_SDK_ROOT}/host-sdk.json" pxa_sdk_manifest_actual)
if(NOT pxa_sdk_manifest_hash STREQUAL pxa_sdk_manifest_actual)
    message(FATAL_ERROR "PXA Host SDK manifest differs from product lock")
endif()
file(READ "${PXA_HOST_SDK_ROOT}/host-sdk.json" pxa_sdk_manifest)
set(pxa_sdk_tool "${PXA_HOST_SDK_ROOT}/tools/host-sdk/pxa_host_sdk.py")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pxa_sdk_tool}")
string(JSON pxa_sdk_tool_hash GET "${pxa_sdk_manifest}" files tools/host-sdk/pxa_host_sdk.py sha256)
file(SHA256 "${pxa_sdk_tool}" pxa_sdk_tool_actual)
if(NOT pxa_sdk_tool_hash STREQUAL pxa_sdk_tool_actual)
    message(FATAL_ERROR "PXA Host SDK verifier was modified")
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${pxa_sdk_tool}" verify
    --root "${PXA_HOST_SDK_ROOT}" --lock "${PXA_HOST_SDK_LOCK}"
    RESULT_VARIABLE pxa_sdk_verified OUTPUT_VARIABLE pxa_sdk_verify_output
    ERROR_VARIABLE pxa_sdk_verify_error)
if(NOT pxa_sdk_verified EQUAL 0)
    message(FATAL_ERROR "${pxa_sdk_verify_error}")
endif()
string(STRIP "${pxa_sdk_verify_output}" pxa_sdk_verify_output)
message(STATUS "${pxa_sdk_verify_output}")
# Source edits after configuration must also fail an incremental build. This
# target checks disk files only and adds no code or data to the firmware.
if(NOT TARGET pxa_host_sdk_verify)
    add_custom_target(pxa_host_sdk_verify ALL
        COMMAND "${Python3_EXECUTABLE}" "${pxa_sdk_tool}" verify
                --root "${PXA_HOST_SDK_ROOT}" --lock "${PXA_HOST_SDK_LOCK}"
        VERBATIM)
endif()
set(PXA_HOST_SDK_SYSTEM_ROOT "${PXA_HOST_SDK_ROOT}/deps/pxa-system")
set(PXA_HOST_SDK_COMPONENT_ROOT "${PXA_HOST_SDK_ROOT}/firmware/components")
string(JSON pxa_sdk_count LENGTH "${pxa_sdk_manifest}" components)
math(EXPR pxa_sdk_last "${pxa_sdk_count} - 1")
foreach(pxa_sdk_index RANGE ${pxa_sdk_last})
    string(JSON pxa_sdk_component GET "${pxa_sdk_manifest}" components ${pxa_sdk_index})
    list(APPEND EXTRA_COMPONENT_DIRS "${PXA_HOST_SDK_COMPONENT_ROOT}/${pxa_sdk_component}")
endforeach()
list(APPEND EXTRA_COMPONENT_DIRS "${PXA_HOST_SDK_SYSTEM_ROOT}/wamr")
set(PXA_HOST_SDK_UI_BACKEND "standalone" CACHE STRING "PXA UI bridge: standalone or app_pages")
set_property(CACHE PXA_HOST_SDK_UI_BACKEND PROPERTY STRINGS standalone app_pages)
option(PXA_HOST_SDK_BUILTIN_AUDIO "Use standalone PXA mixer/decoder (OFF for native shared media)" ON)
function(pxa_host_sdk_configure)
    if(PXA_HOST_SDK_UI_BACKEND STREQUAL "app_pages")
        idf_build_set_property(PXA_ENABLE_APP_PAGES_COMPAT ON)
    elseif(PXA_HOST_SDK_UI_BACKEND STREQUAL "standalone")
        idf_build_set_property(PXA_ENABLE_APP_PAGES_COMPAT OFF)
    else()
        message(FATAL_ERROR "Unsupported PXA_HOST_SDK_UI_BACKEND")
    endif()
    idf_build_set_property(PXA_BUILTIN_AUDIO_OUTPUT "${PXA_HOST_SDK_BUILTIN_AUDIO}")
endfunction()
