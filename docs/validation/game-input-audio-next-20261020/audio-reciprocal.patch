@@ -135,6 +135,19 @@ static int16_t interpolate_pcm(int32_t previous, int32_t current,
     const int32_t offset = (int32_t)(magnitude * (output_rate - phase) / output_rate);
     return (int16_t)(previous + (delta < 0 ? -offset : offset));
 }
+static int16_t interpolate_pcm_reciprocal(int32_t previous, int32_t current,
+    uint32_t phase, uint32_t output_rate, uint32_t reciprocal) {
+    const int32_t delta = current - previous;
+    const uint32_t magnitude = (uint32_t)(delta < 0 ? -delta : delta);
+    const uint32_t numerator = magnitude * (output_rate - phase);
+    /* reciprocal=floor(UINT32_MAX/rate). For a 32-bit numerator the
+     * high product underestimates floor(n/rate) by at most one. Correcting
+     * the remainder preserves every sample, including signed truncation.
+     * RV32M emits MULHU here instead of a divide for each output sample. */
+    uint32_t offset = (uint32_t)(((uint64_t)numerator * reciprocal) >> 32);
+    offset += numerator - offset * output_rate >= output_rate;
+    return (int16_t)(previous + (delta < 0 ? -(int32_t)offset : (int32_t)offset));
+}
 static int16_t render_pcm(pxa_audio_mixer_packet_t *p, uint32_t source_rate,
                          uint32_t output_rate) {
     if (source_rate == output_rate) return p->data.pcm[p->position];
