{
  "format": "pxa-package-source-0.1",
  "id": "pxa-ext-indicator-example",
  "version": "0.1.3",
  "release_sequence": 4,
  "name": "Board Indicator Example",
  "description": "Optional workspace peripherals extension: negotiated identity, scoped permission and RGB resource cleanup.",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "build": {
    "system": "cmake",
    "source_dir": "."
  },
  "permissions": [
    {
      "name": "org.doit.peripherals",
      "scope": "indicator.rgb",
      "required": false
    },
    {
      "name": "org.doit.peripherals",
      "scope": "indicator.status",
      "required": false
    }
  ],
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        "ui",
        "permission"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ]
}
