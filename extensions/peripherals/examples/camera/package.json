{
  "format": "pxa-package-source-0.1",
  "id": "pxa-ext-camera-example",
  "version": "0.2.0",
  "release_sequence": 6,
  "name": "相机",
  "description": "摄像头实时预览与JPEG拍照，照片保存在应用私有文件中。",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": true
    }
  },
  "permissions": [
    {
      "name": "org.doit.peripherals",
      "scope": "camera.jpeg",
      "required": false
    }
  ],
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        "ui",
        "permission",
        "clock",
        "fs",
        "log",
        "window",
        "assets"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ]
}
